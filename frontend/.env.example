# =============================================================================
# synCCap Frontend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to source control.

# The base URL of the synCCap Backend Express API.
# Change this if your backend is running on a different port than 3000.
VITE_BACKEND_API_URL=http://localhost:3000

# The base URL of the Canton JSON API.
VITE_CANTON_JSON_API_URL=http://localhost:7575

# The base URL of the Daml Hub / Devnet API (if applicable).
VITE_DEVNET_API_URL=https://ledger-api.validator.devnet.sandbox.fivenorth.io
