# =============================================================================
# synCCap — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Daml / Canton Build Artifacts
# -----------------------------------------------------------------------------
# Compiled Daml archives and intermediate build outputs.
# The .daml/ directory is auto-generated by `dpm build` / `daml build`.
.daml/

# Compiled DAR files (binary artifacts, not source-controlled)
*.dar

# Canton sandbox state and logs (generated at runtime)
canton-sandbox/
sandbox.log
canton.log

# -----------------------------------------------------------------------------
# Node.js / TypeScript (Phase 2 — Backend Integration Layer)
# -----------------------------------------------------------------------------
node_modules/
dist/
build/
*.js.map

# TypeScript build output
*.tsbuildinfo

# Environment variables (may contain private keys or JWT secrets)
.env
.env.local
.env.*.local

# Daml TypeScript codegen output (regenerated from the DAR)
daml.js/
ui/daml.js/

# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# macOS resource forks
._*

# Spotlight index files
.Spotlight-V100
.Trashes

# -----------------------------------------------------------------------------
# VS Code / IDE
# -----------------------------------------------------------------------------
# Keep .vscode/settings.json if it contains project-wide Daml IDE config,
# but ignore personal/machine-specific settings.
.vscode/launch.json
.vscode/tasks.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# -----------------------------------------------------------------------------
# Logs & Temporary Files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Test & Coverage Reports
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
