{
  "name": "synccap-backend",
  "version": "0.1.0",
  "description": "synCCap Integration Layer — Canton Network Ledger API bridge for semiconductor capacity tokenization",
  "private": true,
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "SKIP_LEDGER_TESTS=1 jest --runInBand",
    "test:ledger": "jest --runInBand --testPathPatterns=tests/integration",
    "codegen": "cd .. && dpm build && dpm codegen-js .daml/dist/synccap-v2-0.3.0.dar -o backend/daml.js",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@daml.js/synccap-v2-0.3.0": "file:daml.js/synccap-v2-0.3.0",
    "@daml/types": "3.5.2",
    "@hono/node-server": "^2.0.5",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.26",
    "jsonwebtoken": "^9.0.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
