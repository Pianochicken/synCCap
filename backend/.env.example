# =============================================================================
# synCCap Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to source control.

# -----------------------------------------------------------------------------
# Canton JSON Ledger API
# -----------------------------------------------------------------------------
# The HTTP URL of the Canton participant node's JSON Ledger API V2.
# Start the sandbox with: dpm sandbox --json-api-port 7575 --dar <path>
LEDGER_API_BASE_URL=http://localhost:7575

# Ledger ID used to scope JWT tokens in the sandbox.
# In a real Canton deployment, this is the participant node's ledger ID.
LEDGER_ID=sandbox

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Secret used to sign/verify JWT tokens in sandbox mode.
# In production, replace with RS256 key pair via a proper IAM system.
JWT_SECRET=super-secret-dev-key-replace-in-production

# JWT token expiry duration (in seconds). Default: 3600 (1 hour).
JWT_EXPIRY_SECONDS=3600

# -----------------------------------------------------------------------------
# Express Server
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
